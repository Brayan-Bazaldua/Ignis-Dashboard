# Copiar a .env.prod y completar los valores reales.
# No subir .env.prod a ningun repositorio.

# Dominio publico (sin https://)
DOMAIN=ignis.tudominio.com
API_DOMAIN=api.tudominio.com

# Base de datos
POSTGRES_USER=ignis
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_LARGA
POSTGRES_DB=ignis
DATABASE_URL=postgresql+psycopg://ignis:CAMBIA_ESTA_PASSWORD_LARGA@db:5432/ignis

# API
CORS_ORIGINS=https://ignis.tudominio.com
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=

# Frontend (se hornea en build)
NEXT_PUBLIC_API_URL=https://api.tudominio.com
API_URL=http://api:8000
