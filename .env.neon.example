# Copiar a .env.neon y completar los valores reales.
# No compartir .env.neon (contiene credenciales).

# Dominio publico (sin https://)
DOMAIN=ignis.tudominio.com
API_DOMAIN=api.tudominio.com

# Neon PostgreSQL (obtener en Neon > Connection Details)
# Formato recomendado para SQLAlchemy+psycopg:
# postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# API
CORS_ORIGINS=https://ignis.tudominio.com
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=

# Frontend (se hornea en build)
NEXT_PUBLIC_API_URL=https://api.tudominio.com
API_URL=http://api:8000
